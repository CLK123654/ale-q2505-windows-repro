{
  "change_window": {
    "timezone": "Asia/Shanghai",
    "start": "2026-08-14T22:00:00+08:00",
    "end": "2026-08-14T22:30:00+08:00",
    "decision_wait_minutes": 10
  },
  "impact_scope": {
    "namespace": "queue-platform",
    "workload": "queue-worker",
    "resources": [
      "Deployment/queue-worker",
      "HorizontalPodAutoscaler/queue-worker"
    ],
    "deployment_spec_change_allowed": false,
    "pod_restart_expected": false
  },
  "rollout": {
    "command": "kubectl apply -k release/production",
    "authorized_context_required": true
  },
  "rollback": {
    "command": "kubectl apply -k release/rollback",
    "triggers": [
      "apply_exit_code_nonzero",
      "hpa_condition_AbleToScale_false",
      "hpa_condition_ScalingActive_false"
    ]
  },
  "observation": [
    {
      "metric": "queue_depth",
      "comparison": "less_than_or_equal",
      "boundary": 30
    },
    {
      "metric": "cpu_utilization_percent",
      "comparison": "less_than_or_equal",
      "boundary": 65
    },
    {
      "metric": "hpa_desired_replicas",
      "comparison": "between_inclusive",
      "minimum": 4,
      "maximum": 30
    }
  ]
}
